# =============================================================================
# MB MUSTAPHA - VARIABLES D'ENVIRONNEMENT (marque parametrable : voir section 3)
# Copiez ce fichier en `.env.local` (developpement) puis ajoutez les memes
# variables dans Vercel > Project > Settings > Environment Variables.
# L'application FONCTIONNE SANS AUCUNE VARIABLE (mode demonstration).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) BASE DE DONNEES (optionnelle en demo)
# Postgres gratuit : Neon (neon.tech) ou Supabase (supabase.com)
# Exemple Neon     : postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/afriflow?sslmode=require
# Exemple Supabase : postgresql://postgres.xxx:pass@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Si cette variable est vide => l'app tourne en MODE DEMO (donnees fictives).
# -----------------------------------------------------------------------------
DATABASE_URL=""

# -----------------------------------------------------------------------------
# 2) SECURITE
# Generez une valeur avec : openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET="changez-moi-avec-openssl-rand-base64-32"
# Code supplementaire demande pour entrer dans l'espace PRIVE /admin (vous seul)
ADMIN_PASSCODE="PATRON-2026"

# -----------------------------------------------------------------------------
# 3) MARQUE — le SaaS porte VOTRE nom (nom du fondateur comme signature), partout.
#    Pour tout changer d'un coup :   node scripts/rebrand.mjs --nom "Mon SaaS"
#    Un seul hex controle toute la palette : les tons 50 a 900 sont generes
#    automatiquement par tailwind.config.ts a partir de NEXT_PUBLIC_BRAND_COLOR.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="MB Mustapha"
NEXT_PUBLIC_BRAND_SIGLE="MB"                # 1 a 3 lettres : le sigle dessine dans le logo et l'icone
NEXT_PUBLIC_BRAND_BASELINE="La gestion qui fait rentrer l'argent"
NEXT_PUBLIC_BRAND_COLOR="#1d4ed8"           # bleu profond (couleur principale)
NEXT_PUBLIC_BRAND_ACCENT="#f59e0b"          # ambre (boutons d'action, alertes douces)
NEXT_PUBLIC_BRAND_LOGO=""                    # optionnel : /mon-logo.svg (sinon logo genere)
NEXT_PUBLIC_FOUNDER_NAME="Mahamat Bouba Mustapha"
NEXT_PUBLIC_SUPPORT_EMAIL="contact@mbmustapha.com"        # a confirmer quand le domaine sera achete
# /!\ SEUL CHAMP QUI RESTE A REMPLIR : votre numero WhatsApp professionnel.
#     Il apparait dans l'application, les factures, les flyers et le script de prospection.
NEXT_PUBLIC_SUPPORT_WHATSAPP="+235 66 00 00 00"           # <-- REMPLACER par votre numero reel

# -----------------------------------------------------------------------------
# 4) MAKE.COM  (https://www.make.com)
# Scenario > Webhook > "Copy address". Collez une URL par scenario.
# -----------------------------------------------------------------------------
MAKE_API_TOKEN=""
MAKE_ZONE="eu1.make.com"
MAKE_WEBHOOK_RELANCE=""
MAKE_WEBHOOK_STOCK=""
MAKE_WEBHOOK_PAIEMENT=""
MAKE_WEBHOOK_MESSAGE=""
MAKE_WEBHOOK_RAPPORT=""
MAKE_WEBHOOK_GENERIC=""
# Secret partage : signe les appels entrants ET sortants (HMAC SHA-256)
MAKE_WEBHOOK_SECRET="afriflow-make-secret-a-changer"

# Cle API que Make utilise pour appeler VOTRE app (Authorization: Bearer ...)
AFRIFLOW_API_KEY="afk_live_changez_cette_cle"

# -----------------------------------------------------------------------------
# 5) PAIEMENTS MOBILE MONEY  (abonnements en FCFA)
# Choisissez le(s) agregateur(s) disponible(s) dans votre pays.
# -----------------------------------------------------------------------------
DEFAULT_PAYMENT_PROVIDER="kkiapay"   # kkiapay | cinetpay | paydunya | flutterwave | manuel
KIIAPAY_PUBLIC_KEY=""
KIIAPAY_PRIVATE_KEY=""
KIIAPAY_SECRET=""
KIIAPAY_SANDBOX="true"

CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""

PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""

FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""

# Recu manuel si pas d'agregateur (Tchad : Airtel Money / Moov Africa)
MANUAL_PAYMENT_NUMBER="+235 66 00 00 00 (Airtel Money)"
MANUAL_PAYMENT_NAME="Mahamat Bouba Mustapha"

# -----------------------------------------------------------------------------
# 6) MESSAGERIE (utilisee par Make, pas directement par l'app)
# -----------------------------------------------------------------------------
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
SMTP_HOST=""
SMTP_USER=""
SMTP_PASSWORD=""

# -----------------------------------------------------------------------------
# 7) DIVERS
# -----------------------------------------------------------------------------
CRON_SECRET="cron-secret-a-changer"
CORS_ALLOWED_ORIGIN="*"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
